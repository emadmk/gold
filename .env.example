# ==============================================================================
# KeyhanGold — environment template.
# Copy to `.env` and fill in real values. NEVER commit .env to git.
# ==============================================================================

# ---- Domain ----
DOMAIN=keyhan.gold

# ---- Django ----
DJANGO_SECRET_KEY=                 # use `python -c "import secrets; print(secrets.token_urlsafe(64))"`
DJANGO_SETTINGS_MODULE=core.settings.prod
SERVICE_NAME=keyhan-backend
SERVICE_VERSION=0.1.0
SERVICE_ENV=prod
ALLOWED_HOSTS=keyhan.gold,api.keyhan.gold
CSRF_TRUSTED_ORIGINS=https://keyhan.gold,https://api.keyhan.gold
CORS_ALLOWED_ORIGINS=https://keyhan.gold

# ---- JWT (Ed25519) ----
JWT_PRIVATE_KEY=                   # PEM contents, escaped or in a file
JWT_PUBLIC_KEY=

# ---- Database ----
DB_NAME=keyhan
DB_USER=keyhan
DB_PASS=
DATABASE_URL=postgres://keyhan:password@postgres:5432/keyhan
DB_SSLMODE=prefer

# ---- Redis ----
REDIS_PASS=
REDIS_URL=redis://:password@redis:6379/0
CELERY_BROKER_URL=redis://:password@redis:6379/0

# ---- Object storage (MinIO) ----
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=keyhan
MINIO_SECRET_KEY=
MINIO_BUCKET=keyhan-private

# ---- Observability ----
ELASTICSEARCH_HOSTS=http://elasticsearch:9200
ELASTICSEARCH_USER=elastic
ELASTICSEARCH_PASSWORD=
KIBANA_SYSTEM_PASSWORD=
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
GRAFANA_ADMIN_PASSWORD=

# ---- External providers ----
KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=verify-login

ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true

IDPAY_API_KEY=
IDPAY_SANDBOX=true

PAYPING_API_KEY=
PAYPING_SANDBOX=true

# ---- Email ----
DEFAULT_FROM_EMAIL=noreply@keyhan.gold
