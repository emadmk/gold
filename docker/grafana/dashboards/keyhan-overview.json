{
  "uid": "keyhan-overview",
  "title": "KeyhanGold — Overview",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "API requests / sec",
      "datasource": "Prometheus",
      "targets": [{
        "expr": "sum(rate(django_http_requests_total_by_method_total[1m]))"
      }],
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "HTTP 5xx rate",
      "datasource": "Prometheus",
      "targets": [{
        "expr": "sum(rate(django_http_responses_total_by_status_total{status=~\"5..\"}[5m]))"
      }],
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Orders by state (Prometheus)",
      "datasource": "Prometheus",
      "targets": [{
        "expr": "sum by (state)(rate(django_db_query_duration_seconds_count{model=\"order\"}[5m]))"
      }],
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Domain events / min (Elasticsearch)",
      "datasource": "Elasticsearch",
      "targets": [{
        "metrics": [{ "type": "count", "id": "1" }],
        "bucketAggs": [
          { "id": "2", "type": "date_histogram", "field": "@timestamp", "settings": { "interval": "1m" } }
        ],
        "query": "event.category:domain"
      }],
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 12 }
    }
  ]
}
